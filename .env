# ============================================================================
# Onyx — Environment Configuration
# ============================================================================
# Author : VulnSeeker
# Repo   : onyx-self-learning-agent
#
# Setup:
#   cp .env.example .env
#   # then fill in your real values
#   # NEVER commit .env — it's gitignored
# ============================================================================


# ----------------------------------------------------------------------------
# LLM PROVIDER  (choose ONE — uncomment the block you want)
# ----------------------------------------------------------------------------

# --- OpenAI (paid, best quality) ---
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# --- Groq (free tier, fast, recommended for testing) ---
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# EMBED_MODEL=nomic-embed-text-v1.5

# --- Together AI ---
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# --- Ollama (local, free, no API key) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# EMBED_MODEL=nomic-embed-text


# ----------------------------------------------------------------------------
# SEARCH  (optional — DuckDuckGo used if empty)
# ----------------------------------------------------------------------------
TAVILY_API_KEY=


# ----------------------------------------------------------------------------
# STORAGE
# ----------------------------------------------------------------------------
DATA_DIR=./data
SKILLS_DIR=./data/skills
LOG_LEVEL=INFO


# ----------------------------------------------------------------------------
# AGENT BEHAVIOUR
# ----------------------------------------------------------------------------
MAX_SOURCES_PER_SKILL=12
MAX_PAGES_PER_SOURCE=1
REQUEST_TIMEOUT=20
LLM_MAX_ATTEMPTS=4
CODE_TIMEOUT=20
DEDUPE_DISTANCE=0.12
MAX_CHARS_PER_PAGE=12000


# ----------------------------------------------------------------------------
# WEB DASHBOARD  (optional)
# ----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true


# ----------------------------------------------------------------------------
# SECURITY  (leave empty for local dev)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed OSINT target domains
ALLOWED_TARGET_DOMAINS=
# Enable Docker sandbox instead of subprocess (recommended for production)
USE_DOCKER_SANDBOX=false
# Secret token for API authentication (leave empty to disable)
API_AUTH_TOKEN=


# ----------------------------------------------------------------------------
# OBSERVABILITY  (optional)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=
# Prometheus metrics endpoint
METRICS_ENABLED=false
