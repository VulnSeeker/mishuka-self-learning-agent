# ============================================================================
# .env.example — Onyx Self-Learning Agent
# ============================================================================
# Author : vulnseeker
# Repo   : onyx-self-learning-agent
#
# HOW TO USE:
#   1. Copy this file to `.env`:
#        cp .env.example .env
#   2. Fill in your real values below.
#   3. NEVER commit `.env` to git.
# ============================================================================


# ----------------------------------------------------------------------------
# LLM Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Choose ONE provider:
#
# --- OpenAI (default, paid) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
#
# --- Groq (fast + free tier) ---
# OPENAI_API_KEY=gsk-your-groq-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-70b-versatile
# EMBED_MODEL=nomic-embed-text-v1.5
#
# --- Together AI ---
# OPENAI_API_KEY=your-together-key
# OPENAI_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# EMBED_MODEL=BAAI/bge-large-en-v1.5
#
# --- Ollama (local, free, no API key) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# EMBED_MODEL=nomic-embed-text
#
# --- OpenRouter (multi-model gateway) ---
# OPENAI_API_KEY=sk-or-your-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet
# EMBED_MODEL=openai/text-embedding-3-small


# ----------------------------------------------------------------------------
# Search Configuration (OPTIONAL)
# ----------------------------------------------------------------------------
# If empty, Onyx uses DuckDuckGo (free, no key required).
# Tavily gives better results for agentic search.
TAVILY_API_KEY=


# ----------------------------------------------------------------------------
# Storage & paths (OPTIONAL — defaults shown)
# ----------------------------------------------------------------------------
DATA_DIR=./data
SKILLS_DIR=./data/skills
LOG_LEVEL=INFO


# ----------------------------------------------------------------------------
# Agent behavior tuning (OPTIONAL — defaults shown)
# ----------------------------------------------------------------------------
# How many web sources to crawl per skill bootstrap
MAX_SOURCES_PER_SKILL=12

# How many pages to fetch per source
MAX_PAGES_PER_SOURCE=1

# HTTP request timeout in seconds
REQUEST_TIMEOUT=20

# LLM retry attempts on API errors
LLM_MAX_ATTEMPTS=4

# Code sandbox timeout in seconds
CODE_TIMEOUT=20

# Embedding distance threshold for duplicate detection (0.0–1.0)
# Lower = stricter (fewer duplicates detected as identical)
DEDUPE_DISTANCE=0.12

# Max characters to extract per web page
MAX_CHARS_PER_PAGE=12000


# ----------------------------------------------------------------------------
# Dashboard (OPTIONAL)
# ----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true


# ----------------------------------------------------------------------------
# API SERVICE
# ----------------------------------------------------------------------------
# Bearer token for API auth. Leave empty to disable (dev only).
ONYX_API_TOKEN=
# Comma-separated allowed CORS origins ("*" for all)
ONYX_CORS_ORIGINS=*
# Job TTL in seconds (default 1 hour)
ONYX_JOB_TTL_SECONDS=3600
# Max task text length
ONYX_MAX_TASK_LENGTH=4000

# ----------------------------------------------------------------------------
# DOCKER
# ----------------------------------------------------------------------------
# Enable Docker-based sandbox (requires docker extras)
USE_DOCKER_SANDBOX=false

# ----------------------------------------------------------------------------
# NGROK (optional — for public demos)
# ----------------------------------------------------------------------------
NGROK_AUTHTOKEN=
