# ============================================================================
# .dockerignore — Onyx
# ============================================================================
# Keeps the Docker build context small and prevents secrets from leaking.

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Onyx runtime (never bake into image)
data/
skills/
chroma/
models/
logs/
*.sqlite3
*.sqlite3-*
*.db
*.log

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials.json

# Demo & docs (not needed in runtime image)
demo/
docs/
examples/
site/
*.ipynb

# CI
.github/
